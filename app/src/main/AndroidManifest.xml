<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PitchVision">

        <!-- Entry point / Launcher: Login Screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PitchVision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register Screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="Register - PitchVision"
            android:parentActivityName=".LoginActivity" />

        <!-- Home Screen / Configuration Portal -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="PitchVision - Setup" />

        <!-- Field Screen / Visual Ground & Recommendation -->
        <activity
            android:name=".FieldActivity"
            android:exported="false"
            android:label="PitchVision - Recommended Position"
            android:parentActivityName=".HomeActivity" />

    </application>

</manifest>
